# ─── Neo4j AuraDB ─────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://ab97369a.databases.neo4j.io
NEO4J_USER=ab97369a
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=ab97369a

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ing-datos-II?retryWrites=true&w=majority
MONGO_DB=ing-datos-II

# ─── DataStax Astra (Cassandra) ────────────────────────────────────────────────
# 1. Crear cuenta en https://astra.datastax.com
# 2. Crear database "streaming" (free tier)
# 3. Descargar secure-connect-streaming.zip y colocarlo en la raíz del proyecto
# 4. En "Database Details" > "Generate Token" (role: Database Administrator)
CASSANDRA_BUNDLE_PATH=./secure-connect-streaming.zip
CASSANDRA_TOKEN=AstraCS:your_token_here
CASSANDRA_KEYSPACE=streaming
